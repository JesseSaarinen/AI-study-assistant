# Copy this file to .env and fill in your real values.
# Do not commit your real .env file to GitHub.

# ---------------------------------------------------------------
# Chat model (any OpenAI-compatible API)
# ---------------------------------------------------------------
# The variable names start with OPENAI_ because the app uses the OpenAI
# Python client, but any provider with an OpenAI-compatible endpoint works.
# Uncomment ONE of the provider blocks below and fill in your key.
# Model names change often, so check your provider's current model list.

OPENAI_API_KEY=your_api_key_here

# Option 1: OpenAI (default, requires billing credits)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini (has a free tier)
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-3.5-flash-lite

# Option 3: Groq (has a free tier)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option 4: Ollama (fully local, no real key needed, set the API key above to "ollama")
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2

# ---------------------------------------------------------------
# Embeddings (run locally with Sentence Transformers)
# ---------------------------------------------------------------
# all-MiniLM-L6-v2 works best for English notes. For other languages
# such as Finnish, try paraphrase-multilingual-MiniLM-L12-v2 and
# re-process your PDFs after changing it.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# ---------------------------------------------------------------
# Vector database
# ---------------------------------------------------------------
CHROMA_DB_DIR=storage/chroma
CHROMA_COLLECTION_NAME=study_notes

# ---------------------------------------------------------------
# RAG settings
# ---------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# Maximum allowed ChromaDB distance for retrieved chunks.
# Lower = stricter. Higher = more permissive.
# Set to "disabled" to turn off distance filtering.
RETRIEVAL_DISTANCE_THRESHOLD=1.0

# Maximum size for each uploaded PDF.
MAX_UPLOADED_FILE_MB=50