# Settings for Streamlit Community Cloud.
# Paste these into the app's "Secrets" box (Settings -> Secrets) instead of using a .env file.
# Never commit a real secrets.toml file.

# Google Gemini free tier, OpenAI-compatible endpoint
OPENAI_API_KEY = "your_gemini_api_key_here"
OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
OPENAI_MODEL = "gemini-3.5-flash-lite"  # check the current model list

# Groq free tier alternative
# OPENAI_API_KEY = "your_groq_api_key_here"
# OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
# OPENAI_MODEL = "llama-3.3-70b-versatile"

# Public demo protections: per-session collections and a question budget.
DEMO_MODE = "true"
DEMO_MAX_QUESTIONS = "20"
MAX_UPLOADED_FILE_MB = "10"
